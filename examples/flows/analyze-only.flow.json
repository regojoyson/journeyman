{
  "name": "analyze-only",
  "description": "Smoke flow: a single 'analyze-repo' phase fed by run inputs.",
  "definition": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "config": {
          "runInputs": [
            { "name": "repoDir",      "type": "string", "required": true },
            { "name": "issueContent", "type": "string", "required": true }
          ]
        }
      },
      {
        "id": "n_analyze",
        "type": "phase",
        "phaseType": "analyze-repo",
        "inputs": {
          "repoDir":      { "kind": "ref", "ref": "workflow.input.repoDir" },
          "issueContent": { "kind": "ref", "ref": "workflow.input.issueContent" }
        }
      },
      { "id": "end", "type": "end" }
    ],
    "edges": [
      { "id": "e1", "source": "start",     "target": "n_analyze" },
      { "id": "e2", "source": "n_analyze", "target": "end" }
    ]
  }
}
