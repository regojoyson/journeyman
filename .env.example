# Journeyman — copy to .env and fill in values
#   cp .env.example .env
#
# Generate secrets with:
#   openssl rand -hex 32

# --- Database (required) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5433/journeyman

# --- API server (required) ---
PORT=4000
LOG_LEVEL=info
# memory | postgres
STORE_BACKEND=postgres

# --- Identity (required) ---
# JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=

# When "true" the auth middleware enforces real JWT/api-token auth on every
# protected route. When "false", a synthetic admin RunContext is injected so
# existing flows keep running without login. Now that the secrets vault has
# landed, "true" is the intended runtime mode.
IDENTITY_ENFORCE=true

# Token TTLs (optional). Defaults: access = 900 (15 min), refresh = 2592000 (30 days).
# These also drive the corresponding cookie Max-Age values.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Secrets vault (required when IDENTITY_ENFORCE=true) ---
# AES-256-GCM key for encrypting user/org-scope secrets at rest.
# Preferred: 64 hex chars (real 32-byte key). Generate: openssl rand -hex 32
# Fallback: any string >=32 chars (will be SHA-256'd; dev-only).
JM_SECRET_ENCRYPTION_KEY=

# --- Global secrets (optional) ---
# Any env var of the form JM_GLOBAL_<NAME> becomes a global-tier secret named
# <NAME>, available to every run when neither user-scope nor org-scope has it.
# Precedence at run time: user > org > global.
# Examples:
# JM_GLOBAL_GITHUB_TOKEN=ghp_shared_default_here
# JM_GLOBAL_OPENAI_API_KEY=sk-...

# --- AI provider ---
# Required for AI steps under docker-compose (no `claude login` inside a container).
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# --- GitHub provider (legacy fallback — prefer JM_GLOBAL_GITHUB_TOKEN or per-user secret) ---
GITHUB_ACCESS_TOKEN=ghp_your_github_pat_here

# --- Worker / orchestrator data root ---
# Single data root. Everything Journeyman writes lives under here:
#   <JOURNEYMAN_BASE_DIR>/workspaces/<runId>/   local run workspaces
#   <JOURNEYMAN_BASE_DIR>/skills/<name>-<hash>/ skill packages cache
#   <JOURNEYMAN_BASE_DIR>/kit/                  kit.json (pushed image digests)
#
# Running on your host (npm run start:worker): this is the real folder used directly.
#   Falls back to ~/.journeyman when not set.
# Under docker-compose (npm run compose:up): this is the HOST folder bind-mounted into
#   the worker at /data/journeyman (the in-container path is fixed). Defaults to
#   ./.journeyman-data when not set. compose-up.sh also builds the kit here.
JOURNEYMAN_BASE_DIR=/your/path/to/journeyman-data

# --- Runner kit registry (replaces the old tar kit) ---
# Any OCI registry: local (localhost:5000), GHCR (ghcr.io/acme),
# GitLab (registry.gitlab.com/acme/journeyman), Docker Hub, ECR, …
# build:kit pushes runner-base/runner-bundle here; register-kit records the
# resulting digests in the kit_images table; workers pull by digest.
JOURNEYMAN_REGISTRY=localhost:5000
# Optional credentials for private registries (leave blank for open/local):
JOURNEYMAN_REGISTRY_USERNAME=
JOURNEYMAN_REGISTRY_TOKEN=
# Optional fallback image refs used only when kit_images has no row yet:
# JOURNEYMAN_RUNNER_BUNDLE=journeyman/runner-bundle:dev
# JOURNEYMAN_RUNNER_IMAGE=journeyman/runner-base:dev

# WORKER_ID=worker-1
# RUN_SYNC_INTERVAL_MS=2000
# CYCLE_VISIT_LIMIT=100
# CONDUCTOR_BASE_URL=http://localhost:8080/api
# Interval (ms) each step-type loop waits between Conductor polls.
# Lower = faster step pickup but more requests/logs. Default 2000.
# WORKER_POLL_INTERVAL_MS=2000

# --- Webhook-wait safety net (optional) ---
# Workflows can pause at a `webhook-wait` node until a matching webhook event
# arrives. Authors can set a per-node `timeout`, but they may forget — or set it
# huge. These two vars are the operator-level backstop so paused workflows
# don't pile up forever.
#
# MAX_AGE = "the longest a workflow may sit waiting on any webhook-wait".
#   When a paused node passes this age, the system gives up waiting and pushes
#   the workflow down its timeout branch (same as if the node's own timeout
#   fired). The instance completes normally instead of leaking.
#   Format: duration string like "30d", "12h", "90m".
#   Set to "off" to disable the safety net entirely (not recommended in prod).
#   Default: 30d
# JOURNEYMAN_WEBHOOK_WAIT_MAX_AGE=30d
#
# SWEEP_INTERVAL = "how often we check for over-age paused nodes".
#   Shorter = stuck workflows get cleaned up faster, but more DB checks.
#   Longer  = less DB load, but a node may linger up to one interval past MAX_AGE.
#   Format: duration string like "5m", "1h".
#   Default: 5m
# JOURNEYMAN_WEBHOOK_WAIT_SWEEP_INTERVAL=5m

# --- Optional integrations ---
# SLACK_BOT_TOKEN=xoxb-...
# ATLASSIAN_API_TOKEN=...

# --- Docker Compose deployment (used by `npm run compose:up`) ---
# The host data folder is JOURNEYMAN_BASE_DIR (see above) — it's bind-mounted into the
# worker at /data/journeyman, and compose-up.sh builds the runner kit there. Leave it
# unset to use the default ./.journeyman-data.
#
# Required secrets (compose-up.sh aborts if either is empty):
#   JWT_SECRET                 — openssl rand -hex 32
#   JM_SECRET_ENCRYPTION_KEY   — openssl rand -hex 32
