# Journeyman — copy to .env and fill in values
#   cp .env.example .env
#
# Generate secrets with:
#   openssl rand -hex 32

# --- Database (required) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5433/journeyman

# --- API server (required) ---
PORT=4000
LOG_LEVEL=info
# memory | postgres
STORE_BACKEND=postgres

# --- Identity (required) ---
# JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=

# When "true" the auth middleware enforces real JWT/api-token auth on every
# protected route. When "false", a synthetic admin RunContext is injected so
# existing flows keep running without login. Now that the secrets vault has
# landed, "true" is the intended runtime mode.
IDENTITY_ENFORCE=true

# Token TTLs (optional). Defaults: access = 900 (15 min), refresh = 2592000 (30 days).
# These also drive the corresponding cookie Max-Age values.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Secrets vault (required when IDENTITY_ENFORCE=true) ---
# AES-256-GCM key for encrypting user/org-scope secrets at rest.
# Preferred: 64 hex chars (real 32-byte key). Generate: openssl rand -hex 32
# Fallback: any string >=32 chars (will be SHA-256'd; dev-only).
JM_SECRET_ENCRYPTION_KEY=

# --- Global secrets (optional) ---
# Any env var of the form JM_GLOBAL_<NAME> becomes a global-tier secret named
# <NAME>, available to every run when neither user-scope nor org-scope has it.
# Precedence at run time: user > org > global.
# Examples:
# JM_GLOBAL_GITHUB_TOKEN=ghp_shared_default_here
# JM_GLOBAL_OPENAI_API_KEY=sk-...

# --- AI provider (required only if NOT logged in via `claude login`) ---
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# --- GitHub provider (legacy fallback — prefer JM_GLOBAL_GITHUB_TOKEN or per-user secret) ---
GITHUB_ACCESS_TOKEN=ghp_your_github_pat_here

# --- Worker / orchestrator (optional — sensible defaults) ---
# WORKER_ID=worker-1
# RUN_SYNC_INTERVAL_MS=2000
# CYCLE_VISIT_LIMIT=100
# CONDUCTOR_BASE_URL=http://localhost:8080/api

# --- Optional integrations ---
# SLACK_BOT_TOKEN=xoxb-...
# ATLASSIAN_API_TOKEN=...
