# Journeyman — copy to .env and fill in values
#   cp .env.example .env
#
# Generate secrets with:
#   openssl rand -hex 32

# --- Required ---
JOURNEYMAN_API_TOKEN=
GITHUB_ACCESS_TOKEN=ghp_your_github_pat_here

# --- Required only if NOT logged in via `claude login` (server/Docker/CI) ---
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# --- Required only for real GitHub webhooks (not for manual trigger) ---
GITHUB_WEBHOOK_SECRET=

# --- Optional ---
# SLACK_BOT_TOKEN=xoxb-...
