# Journeyman — DOCKER-COMPOSE DEPLOY env (npm run compose:up).
#   cp .env.production.example .env.production
#
# This file is read by compose-up.sh and injected into the api-server/worker/migrations
# containers (env_file: .env.production). It is intentionally separate from the dev .env
# so settings can't clash — most importantly the registry port (deploy 5000 vs dev 5500).
#
# DATABASE_URL / CONDUCTOR_BASE_URL are set per-service inside compose.deploy.yml
# (in-network hostnames), so they are NOT set here.
#
# Generate secrets with:
#   openssl rand -hex 32

# --- Identity (required) ---
JWT_SECRET=
IDENTITY_ENFORCE=true

# --- Secrets vault (required when IDENTITY_ENFORCE=true) ---
JM_SECRET_ENCRYPTION_KEY=

# --- API server ---
LOG_LEVEL=info

# --- AI provider (required for AI steps; no `claude login` inside a container) ---
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# --- GitHub provider (legacy fallback — prefer JM_GLOBAL_GITHUB_TOKEN or per-user secret) ---
# GITHUB_ACCESS_TOKEN=ghp_your_github_pat_here

# --- Global secrets (optional) ---
# JM_GLOBAL_GITHUB_TOKEN=ghp_shared_default_here

# --- Data root ---
# Host folder bind-mounted into the worker at /data/journeyman. Defaults to
# ./.journeyman-data when unset.
# JOURNEYMAN_BASE_DIR=/your/path/to/journeyman-data

# --- Runner kit registry ---
# Deploy default: the bundled registry compose:up starts on localhost:5000 (shares
# dind's network namespace so the host and dind agree on the address).
# Point this at GHCR/GitLab/ECR/Docker Hub to use an external registry instead.
JOURNEYMAN_REGISTRY=localhost:5000
# Optional credentials for private registries (leave blank for the bundled/local one):
JOURNEYMAN_REGISTRY_USERNAME=
JOURNEYMAN_REGISTRY_TOKEN=
# Optional fallback image refs used only when kit_images has no row yet:
# JOURNEYMAN_RUNNER_BUNDLE=journeyman/runner-bundle:dev
# JOURNEYMAN_RUNNER_IMAGE=journeyman/runner-base:dev

# --- Optional integrations ---
# SLACK_BOT_TOKEN=xoxb-...
# ATLASSIAN_API_TOKEN=...
