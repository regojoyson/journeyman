{
  "name": "journeyman",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check": "npm run typecheck && npm run check:boundaries",
    "test": "npm test --workspaces --if-present",
    "infra:up": "docker compose -f infra/compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/compose.dev.yml down",
    "infra:reset": "docker compose -f infra/compose.dev.yml down -v",
    "images:build": "./scripts/build-images.sh",
    "compose:up": "./scripts/compose-up.sh",
    "compose:down": "docker compose -f compose.deploy.yml down",
    "compose:reset": "docker compose -f compose.deploy.yml down -v",
    "k8s:up": "./scripts/k8s-up.sh",
    "k8s:down": "kubectl delete -k deploy/k8s/overlays/local --ignore-not-found",
    "k8s:reset": "kubectl delete -k deploy/k8s/overlays/local --ignore-not-found && kubectl -n journeyman delete pvc --all --ignore-not-found",
    "migrate": "DATABASE_URL=${DATABASE_URL:-postgres://postgres:postgres@localhost:5433/journeyman} npm run migrate -w @journeyman/migrations",
    "start:api-server": "npm start -w @journeyman/api-server",
    "start:worker": "tsx packages/orchestrator/src/cli-worker.ts",
    "dev:web": "npm run dev -w @journeyman/web",
    "build:web": "npm run build -w @journeyman/web",
    "build:kit": "node scripts/build-kit.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.112",
    "@types/node": "^25.6.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "pino": "^10.3.1"
  }
}
